{
  "id": "codex",
  "name": "Codex CLI",
  "kind": "CLI de IA",
  "command": "codex",
  "versionArgs": ["--version"],
  "sessionArgs": [],
  "install": "npm install -g @openai/codex",
  "http": null,
  "authenticates": true,
  "authCheck": { "files": ["%CODEX_HOME%\\auth.json", "%USERPROFILE%\\.codex\\auth.json"] },
  "headless": {
    "args": ["exec", "--sandbox", "workspace-write", "--skip-git-repo-check", "-"],
    "prompt": "stdin",
    "output": "text",
    "timeoutMs": 900000,
    "sources": [
      "https://learn.chatgpt.com/docs/non-interactive-mode"
    ]
  },
  "order": 2
}
